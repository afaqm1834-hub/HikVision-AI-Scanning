# Python cache and build artifacts
__pycache__/
*.py[cod]
*.py[cod].*
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local editor and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime logs and captured images
app/logs/*
/logs/
*.log
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.heic
*.mp4
*.avi
*.mkv
!app/logs/.gitkeep

# Generated employee embeddings and enrollment datasets
app/employees*.json
**/*embedding*.json
app/synced-enrollments/
synced-enrollments/
dataset/
app/dataset/
unknown_faces/
app/unknown_faces/

# Scanner process state
.scanner.lock
*.pid

# Downloaded models, numerical arrays, and archives
app/models/*
!app/models/.gitkeep
buffalo_l/
*.zip
*.7z
*.tar
*.gz
*.onnx
*.pt
*.pth
*.pb
*.h5
*.tflite
*.safetensors
*.npy
*.npz
*.pkl
*.pickle

# Local configuration can contain camera passwords and API keys
app/config.yaml
.env
.env.*
!.env.example
